  if j.op == 123 {
    let point = unsafe ssl.EC_KEY_get0_public_key(ec)
    let length = unsafe ssl.EC_POINT_point2oct(group, point, 4, nil(), 0, nil())
    ok = length > 0 && unsafe reserve(&mut j, length) && unsafe ssl.EC_POINT_point2oct(group, point, 4, j.output, length, nil()) == length
  } else {
    let nid = unsafe xssl.EC_GROUP_get_curve_name(group)
