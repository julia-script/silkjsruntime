unsafe fn named(j: &Job, i: usize) -> Option<digest.Algorithm> { let a = () return digest.lookup(unsafe view(&a, j.data[i], j.lengths[i])) }
unsafe fn placeHash(j: &mut Job, handle: HashHandle) -> bool {
  j.resultKind = 2 j.createdKind = 1 j.created = unsafe ssl.calloc(1, Layout.of<HashHandle>().bytes)
  if Pointer.isNull<u8>(j.created) { return false }
  unsafe Pointer.put<HashHandle>(unsafe hashAt(j.created), move handle) return true
}
unsafe fn placeMac(j: &mut Job, state: MacState) -> bool {
  j.resultKind = 2 j.createdKind = 2 j.created = unsafe ssl.calloc(1, Layout.of<MacState>().bytes)
  if Pointer.isNull<u8>(j.created) { return false }
  unsafe Pointer.put<MacState>(unsafe macAt(j.created), move state) return true
}
/// Hashes, HMAC, PBKDF2, HKDF and scrypt, all on silk.crypto.
unsafe fn executeDigest(j: &mut Job) -> bool {
  let op = j.op
  if op == 60 {
    j.resultKind = 3 let names = digest.HASH_NAMES
    if !unsafe reserve(&mut j, names.length) { return false }
    let mut a = () let out = unsafe output(&mut a, &j.*, names.length)
    let mut i: usize = 0 while i < names.length { out[i] = names[i] i = i + 1 }
    return true
  }
  if op == 11 {
    j.resultKind = 4 let a = () let input = unsafe view(&a, j.data[1], j.lengths[1])
    let mut b = () let h = unsafe Pointer.borrowMut<(), HashHandle>(&mut b, unsafe hashAt(j.handle))
    h.state.update(input) return true
  }
  if op == 15 {
    j.resultKind = 4 let a = () let input = unsafe view(&a, j.data[1], j.lengths[1])
    let mut b = () let h = unsafe Pointer.borrowMut<(), MacState>(&mut b, unsafe macAt(j.handle))
    h.update(input) return true
  }
  if op == 12 {
    let p = unsafe hashAt(j.handle)
    let b = () let h = unsafe Pointer.borrow<(), HashHandle>(&b, p) let algorithm = h.algorithm drop h
    let mut length = digest.digestLength(algorithm)
    if j.numbers[1] >= 0 { if !digest.isXof(algorithm) { return false } length = i64.toUsize(j.numbers[1]) }
    let mut capacity = length if capacity < 64 { capacity = 64 }
    if !unsafe reserve(&mut j, capacity) { return false }
    let owned = unsafe Pointer.take<HashHandle>(p)
    unsafe Pointer.put<HashHandle>(p, HashHandle { algorithm: algorithm, state: HashState.Finished })
    let mut a = () let written = owned.state.finishInto(unsafe output(&mut a, &j.*, length))
    j.length = written return true
  }
  if op == 16 {
    if !unsafe reserve(&mut j, 64) { return false }
    let p = unsafe macAt(j.handle)
    let owned = unsafe Pointer.take<MacState>(p)
    unsafe Pointer.put<MacState>(p, MacState.Finished)
    let mut a = () let written = owned.finishInto(unsafe output(&mut a, &j.*, 64))
    j.length = written return true
  }
  if op == 13 {
    let b = () let h = unsafe Pointer.borrow<(), HashHandle>(&b, unsafe hashAt(j.handle))
    let copy = HashHandle { algorithm: h.algorithm, state: h.state.copy() } drop h
    return unsafe placeHash(&mut j, move copy)
  }
  if op == 4 { return unsafe scrypt(&mut j) }
  let mut nameIndex: usize = 0 if op == 3 { nameIndex = 4 }
  let algorithm = match unsafe named(&j.*, nameIndex) { Option.Some { value } => value Option.None => { return unsafe unknownDigest(&mut j, nameIndex) } }
  if op == 9 { j.resultKind = 1 j.result = usize.toI64(digest.digestLength(algorithm)) return true }
  if op == 10 { return unsafe placeHash(&mut j, HashHandle { algorithm: algorithm, state: HashState.make(algorithm) }) }
  if op == 14 {
    let a = () let key = unsafe view(&a, j.data[1], j.lengths[1])
    return match MacState.make(algorithm, key) { Option.Some { value } => unsafe placeMac(&mut j, move value) Option.None => false }
  }
  if (op == 3 || op == 5) && digest.isXof(algorithm) { return unsafe providerFailure(&mut j, b"error:1C8000B7:Provider routines::xof digests not allowed") }
  if op == 3 {
    let length = i64.toUsize(j.numbers[3])
    if !unsafe reserve(&mut j, length) { return false }
    let a = () let password = unsafe view(&a, j.data[0], j.lengths[0]) let salt = unsafe view(&a, j.data[1], j.lengths[1])
    let mut b = () return digest.pbkdf2(algorithm, password, salt, i64.toU32(j.numbers[2]), unsafe output(&mut b, &j.*, length))
  }
  if op == 5 {
    let length = i64.toUsize(j.numbers[4])
    if length == 0 { return unsafe providerFailure(&mut j, b"error:1C800069:Provider routines::invalid key length") }
    if length > 255 * digest.digestLength(algorithm) { return unsafe providerFailure(&mut j, b"ERR_CRYPTO_INVALID_KEYLEN: Invalid key length") }
    if !unsafe reserve(&mut j, length) { return false }
    let a = () let key = unsafe view(&a, j.data[1], j.lengths[1]) let salt = unsafe view(&a, j.data[2], j.lengths[2]) let info = unsafe view(&a, j.data[3], j.lengths[3])
    let mut b = () return digest.hkdf(algorithm, key, salt, info, unsafe output(&mut b, &j.*, length))
  }
  if op == 6 {
    let mut length = digest.digestLength(algorithm)
    if j.numbers[3] == 1 { if !digest.isXof(algorithm) { return false } length = i64.toUsize(j.numbers[2]) }
    let mut capacity = length if capacity < 64 { capacity = 64 }
    if !unsafe reserve(&mut j, capacity) { return false }
    let a = () let input = unsafe view(&a, j.data[1], j.lengths[1])
    let mut state = HashState.make(algorithm) state.update(input)
    let mut b = () j.length = state.finishInto(unsafe output(&mut b, &j.*, length)) return true
  }
  if !unsafe reserve(&mut j, 64) { return false }
  let a = () let key = unsafe view(&a, j.data[1], j.lengths[1]) let input = unsafe view(&a, j.data[2], j.lengths[2])
  let mut state = match MacState.make(algorithm, key) { Option.Some { value } => move value Option.None => { return false } }
  state.update(input)
  let mut b = () j.length = state.finishInto(unsafe output(&mut b, &j.*, 64)) return true
}
/// scrypt with the same memory rule as OpenSSL: 128 * r * (N + p + 2) bytes must fit in maxmem.
unsafe fn scrypt(j: &mut Job) -> bool {
  let length = i64.toUsize(j.numbers[2])
  let cost = i64.toU64(j.numbers[3]) let blockSize = i64.toU32(j.numbers[4]) let parallelism = i64.toU32(j.numbers[5])
  let mut limit = i64.toU64(j.numbers[6]) if limit == 0 { limit = 33554432 }
  let memory = match Scrypt.memoryLength(cost, blockSize, parallelism) { Option.Some { value } => value Option.None => { return unsafe providerFailure(&mut j, SCRYPT_MEMORY) } }
  if memory > limit { return unsafe providerFailure(&mut j, SCRYPT_MEMORY) }
  let words = match Scrypt.scratchLength(cost, blockSize, parallelism) { Option.Some { value } => value Option.None => { return unsafe providerFailure(&mut j, SCRYPT_MEMORY) } }
  if !unsafe reserve(&mut j, length) { return false }
  let scratch = unsafe ssl.malloc(words * 4) if Pointer.isNull<u8>(scratch) { return false }
  let a = () let password = unsafe view(&a, j.data[0], j.lengths[0]) let salt = unsafe view(&a, j.data[1], j.lengths[1])
  let mut s = () let table = unsafe Pointer.borrowManyMut<(), u32>(&mut s, unsafe Pointer.assumeManyMut<u32>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut u32>(unsafe nonnull(scratch))), words)
  let mut b = ()
  let ok = match Scrypt.deriveWithScratch(password, salt, cost, blockSize, parallelism, move table, unsafe output(&mut b, &j.*, length)) { Result<(), ScryptError>.Success { .. } => true Result<(), ScryptError>.Failure { .. } => false }
  unsafe ssl.OPENSSL_cleanse(scratch, words * 4) unsafe ssl.free(scratch)
  if !ok { return unsafe providerFailure(&mut j, b"ERR_CRYPTO_INVALID_SCRYPT_PARAMS: Invalid scrypt params") }
  return true
}
const SCRYPT_MEMORY: &'static [u8] = b"ERR_CRYPTO_INVALID_SCRYPT_PARAMS: Invalid scrypt params: error:030000AC:digital envelope routines::memory limit exceeded"
/// Fails the way Node does for a digest name it does not know: OpenSSL's legacy-provider error for
/// names only that provider has, and otherwise "Digest method not supported" for hashes or
/// ERR_CRYPTO_INVALID_DIGEST naming the digest for everything else.
unsafe fn unknownDigest(j: &mut Job, index: usize) -> bool {
  let a = () let name = unsafe view(&a, j.data[index], j.lengths[index])
  if digest.isLegacy(name) { return unsafe providerFailure(&mut j, b"ERR_OSSL_EVP_UNSUPPORTED: error:0308010C:digital envelope routines::unsupported") }
  if j.op == 6 || j.op == 9 || j.op == 10 { return unsafe providerFailure(&mut j, b"ERR_NONE: Digest method not supported") }
  let prefix = b"ERR_CRYPTO_INVALID_DIGEST: Invalid digest: "
  let mut i: usize = 0
  while i < prefix.length { unsafe Pointer.put<u8>(unsafe buffers.dataAt(j.error, usize.toU64(i)), prefix[i]) i = i + 1 }
  let mut k: usize = 0
  while k < name.length && i < 255 { unsafe Pointer.put<u8>(unsafe buffers.dataAt(j.error, usize.toU64(i)), name[k]) i = i + 1 k = k + 1 }
  unsafe Pointer.put<u8>(unsafe buffers.dataAt(j.error, usize.toU64(i)), 0)
  j.codedError = true return false
}
/// A cipher handle: the checked key and IV, the padding and associated data set before the first
/// update, and the state once it started.
struct CipherHandle {
  setup: Setup, padding: bool, started: bool, state: CipherState,
  aad: ?*mut u8, aadLength: usize, aadCapacity: usize, plaintextLength: i64,
  tag: [u8; 16], tagLength: usize, sealedTag: [u8; 16], total: usize,
}
unsafe fn cipherAt(p: ?*mut u8) -> *mut CipherHandle { return unsafe Intrinsic.pointerReinterpret<*mut u8, *mut CipherHandle>(unsafe nonnull(p)) }
unsafe fn cipherFailure(j: &mut Job, error: CipherError) -> bool { return unsafe providerFailure(&mut j, cipher.errorText(move error)) }
unsafe fn appendAad(h: &mut CipherHandle, data: ?*mut u8, length: usize) -> bool {
  if length == 0 { return true }
  if h.aadLength + length > h.aadCapacity {
    let capacity = (h.aadLength + length) * 2
    let resized = unsafe ssl.realloc(h.aad, capacity)
    if Pointer.isNull<u8>(resized) { return false }
    h.aad = resized h.aadCapacity = capacity
  }
  let a = () let source = unsafe view(&a, data, length)
  let mut b = () let target = unsafe Pointer.borrowManyMut<(), u8>(&mut b, unsafe Pointer.assumeManyMut<u8>(unsafe nonnull<u8>(h.aad)), h.aadCapacity)
  Slice.copyInto<u8>(move target, h.aadLength, source)
  h.aadLength = h.aadLength + length return true
}
// Builds the state the first time data or the end arrives.
unsafe fn startCipher(h: &mut CipherHandle) -> Result<(), CipherError> {
  if h.started { return Result<(), CipherError>.succeed(()) }
  let a = () let aad = unsafe view(&a, h.aad, h.aadLength)
  return match CipherState.start(&h.setup, h.padding, aad) {
    Result.Success { value } => { h.state = move value h.started = true Result<(), CipherError>.succeed(()) }
    Result.Failure { error } => Result<(), CipherError>.failResult(move error)
  }
}
unsafe fn cipherUpdate(j: &mut Job, h: &mut CipherHandle, input: &[u8]) -> bool {
  if let Result.Failure { error } = unsafe startCipher(&mut h) { return unsafe cipherFailure(&mut j, move error) }
  if !unsafe reserve(&mut j, input.length + 48) { return false }
  let a = () let aad = unsafe view(&a, h.aad, h.aadLength)
  let tag = Slice.view<u8>(&h.tag, 0, h.tagLength)
  let mut b = ()
  let result = h.state.update(&h.setup, aad, h.plaintextLength, tag, input, unsafe output(&mut b, &j.*, input.length + 48))
  h.total = h.total + input.length
  return match move result {
    Result.Success { value } => { j.length = value true }
    Result.Failure { error } => unsafe cipherFailure(&mut j, move error)
  }
}
unsafe fn cipherFinish(j: &mut Job, h: &mut CipherHandle) -> bool {
  if let Result.Failure { error } = unsafe startCipher(&mut h) { return unsafe cipherFailure(&mut j, move error) }
  if !unsafe reserve(&mut j, 48) { return false }
  let mode = cipher.spec(h.setup.index).mode
  let blocks = match mode { Mode.Ecb => true Mode.Cbc => true _ => false }
  // OpenSSL refuses to unpad an empty ciphertext.
  if blocks && !h.setup.encrypt && h.padding && h.total == 0 { return unsafe cipherFailure(&mut j, CipherError.WrongFinalBlockLength) }
  let state = Intrinsic.replace(h.state, CipherState.Finished)
  let a = () let aad = unsafe view(&a, h.aad, h.aadLength)
  let tag = Slice.view<u8>(&h.tag, 0, h.tagLength)
  let mut b = ()
  let result = state.finish(&h.setup, aad, tag, unsafe output(&mut b, &j.*, 48), &mut h.sealedTag)
  return match move result {
    Result.Success { value } => { j.length = value true }
    Result.Failure { error } => unsafe cipherFailure(&mut j, move error)
  }
}
unsafe fn namedCipher(j: &Job, i: usize) -> Option<u32> { let a = () return cipher.lookup(unsafe view(&a, j.data[i], j.lengths[i])) }
/// Ciphers on silk.crypto: creation, update, final, tags, padding, the one-shot form WebCrypto uses,
/// the cipher list and cipher information.
unsafe fn executeCipher(j: &mut Job) -> bool {
  let op = j.op
  if op == 61 {
    j.resultKind = 3 let names = cipher.CIPHER_NAMES
    if !unsafe reserve(&mut j, names.length) { return false }
    let mut a = () Slice.copyInto<u8>(unsafe output(&mut a, &j.*, names.length), 0, names) return true
  }
  if op == 68 { return unsafe cipherInfo(&mut j) }
  if op == 20 {
    let encrypt = j.numbers[3] == 1 let tagLength = i64.toUsize(j.numbers[4])
    let made = unsafe cipherCreateNamed(&mut j, 0, 1, 2, encrypt, tagLength)
    return match move made {
      Option.Some { value } => {
        j.resultKind = 2 j.createdKind = 3 j.created = unsafe ssl.calloc(1, Layout.of<CipherHandle>().bytes)
        if Pointer.isNull<u8>(j.created) { return false }
        unsafe Pointer.put<CipherHandle>(unsafe cipherAt(j.created), move value) true
      }
      Option.None => false
    }
  }
  if op == 7 { return unsafe cipherOnce(&mut j) }
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), CipherHandle>(&mut anchor, unsafe cipherAt(j.handle))
  if op == 21 { let a = () let input = unsafe view(&a, j.data[1], j.lengths[1]) return unsafe cipherUpdate(&mut j, &mut h, input) }
  if op == 22 { return unsafe cipherFinish(&mut j, &mut h) }
  j.resultKind = 4
  if op == 23 {
    if h.started { return unsafe providerFailure(&mut j, b"ERR_CRYPTO_INVALID_STATE: Invalid state for operation setAAD") }
    h.plaintextLength = j.numbers[2]
    return unsafe appendAad(&mut h, j.data[1], j.lengths[1])
  }
  if op == 24 {
    let a = () let tag = unsafe view(&a, j.data[1], j.lengths[1])
    if tag.length > 16 { return false }
    Slice.copyInto<u8>(&mut h.tag, 0, tag) h.tagLength = tag.length return true
  }
  if op == 25 {
    let length = i64.toUsize(j.numbers[1]) if length > 16 { return false }
    j.resultKind = 0 if !unsafe reserve(&mut j, length) { return false }
    let mut a = () Slice.copyInto<u8>(unsafe output(&mut a, &j.*, length), 0, Slice.view<u8>(&h.sealedTag, 0, length)) return true
  }
  if op == 26 { if !h.started { h.padding = j.numbers[1] != 0 } return true }
  return false
}
unsafe fn cipherCreateNamed(j: &mut Job, name: usize, key: usize, iv: usize, encrypt: bool, tagLength: usize) -> Option<CipherHandle> {
  let index = match unsafe namedCipher(&j.*, name) { Option.Some { value } => value Option.None => { let ignored = unsafe cipherFailure(&mut j, CipherError.UnknownCipher) return Option<CipherHandle>.none() } }
  let a = ()
  let made = Setup.make(index, unsafe view(&a, j.data[key], j.lengths[key]), unsafe view(&a, j.data[iv], j.lengths[iv]), encrypt, tagLength)
  return match move made {
    Result.Success { value } => Option<CipherHandle>.some(CipherHandle { setup: move value, padding: true, started: false, state: CipherState.Pending, aad: nil(), aadLength: 0, aadCapacity: 0, plaintextLength: -1, tag: [0; 16], tagLength: 0, sealedTag: [0; 16], total: 0 })
    Result.Failure { error } => { let ignored = unsafe cipherFailure(&mut j, move error) Option<CipherHandle>.none() }
  }
}
// WebCrypto's one-shot: data[0] name, data[1] key, data[2] IV, data[3] input, numbers[4] encrypt,
// data[5] associated data, data[6] the tag to check, numbers[7] the tag length to append.
unsafe fn cipherOnce(j: &mut Job) -> bool {
  let encrypt = j.numbers[4] == 1
  let mut tagLength = i64.toUsize(j.numbers[7]) if tagLength == 0 || tagLength > 16 { tagLength = 16 }
  let made = unsafe cipherCreateNamed(&mut j, 0, 1, 2, encrypt, tagLength)
  let mut h = match move made { Option.Some { value } => move value Option.None => { return false } }
  let ok = unsafe appendAad(&mut h, j.data[5], j.lengths[5])
  if ok && j.lengths[6] <= 16 { let a = () let tag = unsafe view(&a, j.data[6], j.lengths[6]) Slice.copyInto<u8>(&mut h.tag, 0, tag) h.tagLength = tag.length }
  let a = () let input = unsafe view(&a, j.data[3], j.lengths[3])
  let mut good = ok && unsafe cipherUpdate(&mut j, &mut h, input)
  if !good { unsafe ssl.free(h.aad) drop h return false }
  // Keep the update's bytes while finish writes its own.
  let first = j.output let firstLength = j.length let firstCapacity = j.capacity
  j.output = nil()
  good = unsafe cipherFinish(&mut j, &mut h)
  let second = j.output let secondLength = j.length
  let aead = match cipher.spec(h.setup.index).mode { Mode.Gcm => true Mode.Ccm => true Mode.Ocb => true Mode.Poly1305 => true _ => false }
  let mut tail: usize = 0 if good && aead && encrypt { tail = h.setup.tagLength }
  j.output = unsafe ssl.calloc(1, firstLength + secondLength + tail + 1)
  if good && !Pointer.isNull<u8>(j.output) {
    let mut b = () let out = unsafe output(&mut b, &j.*, firstLength + secondLength + tail)
    let c = ()
    Slice.copyInto<u8>(move out, 0, unsafe view(&c, first, firstLength))
    let mut d = () let out2 = unsafe output(&mut d, &j.*, firstLength + secondLength + tail)
    Slice.copyInto<u8>(move out2, firstLength, unsafe view(&c, second, secondLength))
    let mut e = () let out3 = unsafe output(&mut e, &j.*, firstLength + secondLength + tail)
    Slice.copyInto<u8>(move out3, firstLength + secondLength, Slice.view<u8>(&h.sealedTag, 0, tail))
    j.length = firstLength + secondLength + tail j.capacity = j.length + 1
  } else { good = false }
  if !Pointer.isNull<u8>(first) { unsafe ssl.OPENSSL_cleanse(first, firstCapacity) }
  unsafe ssl.free(first) unsafe ssl.free(second)
  unsafe ssl.free(h.aad) drop h
  return good
}
// getCipherInfo: numbers[3] says data[0] is a NID in numbers[0]; numbers[4] and numbers[5] say a
// key length (numbers[1]) or IV length (numbers[2]) was asked for. An unknown cipher or a length
// the cipher does not take gives undefined.
unsafe fn cipherInfo(j: &mut Job) -> bool {
  j.resultKind = 4
  let found = if j.numbers[3] != 0 { cipher.byNid(i64.toI32(j.numbers[0])) } else { unsafe namedCipher(&j.*, 0) }
  let index = match found { Option.Some { value } => value Option.None => { return true } }
  let entry = cipher.spec(index)
  let mut keyLength = entry.keyLength let mut ivLength = entry.ivLength
  if j.numbers[4] != 0 { if j.numbers[1] != i32.toI64(entry.keyLength) { return true } }
  if j.numbers[5] != 0 {
    if j.numbers[2] < 0 || !cipher.ivAllowed(entry, i64.toUsize(j.numbers[2])) { return true }
    ivLength = i64.toI32(j.numbers[2])
  }
  let name = entry.name
  if !unsafe reserve(&mut j, 20 + name.length) { return false }
  unsafe utilityWord(&mut j, 0, entry.opensslMode) unsafe utilityWord(&mut j, 4, entry.nid)
  unsafe utilityWord(&mut j, 8, entry.blockSize) unsafe utilityWord(&mut j, 12, keyLength)
  unsafe utilityWord(&mut j, 16, ivLength)
  let mut a = () Slice.copyInto<u8>(unsafe output(&mut a, &j.*, 20 + name.length), 20, name)
  j.resultKind = 0 return true
}
