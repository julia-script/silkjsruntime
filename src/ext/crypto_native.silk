// Runs on a blocking worker.
export "C" fn silkCryptoWork(p: ?*mut u8) -> () {
  let j = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Job>(unsafe nonnull(p))
  let mut anchor = () let entry = unsafe Pointer.borrowMut<(), Job>(&mut anchor, j)
  if !unsafe execute(&mut entry) { unsafe recordError(&mut entry) }
