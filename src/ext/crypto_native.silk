unsafe fn providerMacSupports(ctx: ?*mut u8, name: &[u8], kind: u32) -> bool {
  let table = unsafe pssl.EVP_MAC_CTX_settable_params(ctx)
  if Pointer.isNull<pssl.Param>(table) { return false }
  let entry = unsafe pssl.OSSL_PARAM_locate_const(table, Pointer.fromRef<u8>(&name[0]))
  if Pointer.isNull<pssl.Param>(entry) { return false }
  let p = unsafe Intrinsic.pointerRequalify<?*const pssl.Param, *const pssl.Param>(entry)
  let anchor = () let parameter = unsafe Pointer.borrow<(), pssl.Param>(&anchor, p)
  return parameter.dataType == kind
}
unsafe fn providerMacOption(j: &mut Job, ctx: ?*mut u8, name: &[u8], kind: u32) -> bool {
