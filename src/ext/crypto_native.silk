export "C" fn silkCryptoMacAlgorithm(mac: ?*mut u8, opaque: ?*mut u8) -> () {
  let fetched = unsafe pssl.EVP_MAC_fetch(nil(), unsafe pssl.EVP_MAC_get0_name(mac), nil())
  if Pointer.isNull<u8>(fetched) { unsafe ssl.ERR_clear_error() return () }
