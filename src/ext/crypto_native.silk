unsafe effect fn prepare<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, state: *mut State, j: &mut Job, argv: &FrameSlots, asynchronous: bool) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
