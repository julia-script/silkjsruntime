  if (cmac || gmac) && Pointer.isNull<u8>(j.data[3]) { return unsafe providerFailure(&mut j, b"ERR_INVALID_ARG_VALUE: The property 'options.cipher' is required for CMAC or GMAC") }
  if gmac && j.lengths[4] == 0 { return unsafe providerFailure(&mut j, b"ERR_INVALID_ARG_VALUE: The property 'options.iv' must be non-empty for GMAC") }
