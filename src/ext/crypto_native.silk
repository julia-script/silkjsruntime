unsafe fn executeProvider(j: &mut Job) -> bool {
  if j.op == 140 { return unsafe executeProviderArgon2(&mut j) }
  if j.op == 141 { return unsafe executeProviderMacCreate(&mut j) }
  if j.op == 142 { j.resultKind = 4 return unsafe pssl.EVP_MAC_update(j.handle, j.data[1], j.lengths[1]) == 1 }
  if j.op == 143 { let handle = j.handle return unsafe providerMacFinal(&mut j, handle) }
  if j.op == 144 {
    j.resultKind = 3
    let callback: pssl.MacCallback = silkCryptoMacAlgorithm
    unsafe pssl.EVP_MAC_do_all_provided(nil(), callback, unsafe raw(Pointer.fromMutRef<Job>(&mut j)))
    return j.status == 0
  }
  if j.op == 145 || j.op == 146 { return unsafe executeProviderKem(&mut j) }
  if j.op == 147 { return unsafe executeProviderKmac(&mut j) }
  return false
