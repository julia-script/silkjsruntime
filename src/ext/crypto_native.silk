  if j.length != length { return unsafe providerFailure(&mut j, b"ERR_CRYPTO_OPERATION_FAILED: MAC returned an unexpected output length") }
  return true
}
// Internal byte-oriented KMAC primitive for asynchronous WebCrypto jobs.
unsafe fn executeProviderKmac(j: &mut Job) -> bool {
  let mac = unsafe pssl.EVP_MAC_fetch(nil(), j.data[0], nil())
