export "C" fn silkCryptoMacName(name: ?*mut u8, opaque: ?*mut u8) -> () {
  let p = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Job>(unsafe nonnull(opaque))
  let mut anchor = () let j = unsafe Pointer.borrowMut<(), Job>(&mut anchor, p)
