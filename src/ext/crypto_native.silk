/// A hash handle remembers its algorithm so that a final digest knows its default length.
struct HashHandle { algorithm: digest.Algorithm, state: HashState }
unsafe fn hashAt(p: ?*mut u8) -> *mut HashHandle { return unsafe Intrinsic.pointerReinterpret<*mut u8, *mut HashHandle>(unsafe nonnull(p)) }
unsafe fn macAt(p: ?*mut u8) -> *mut MacState { return unsafe Intrinsic.pointerReinterpret<*mut u8, *mut MacState>(unsafe nonnull(p)) }
unsafe fn view<'a>(anchor: &'a (), p: ?*mut u8, n: usize) -> &'a [u8] {
  if n == 0 || Pointer.isNull<u8>(p) { return b"" }
  return unsafe Pointer.borrowMany<(), u8>(anchor, unsafe Pointer.assumeMany<u8>(unsafe nonnull<u8>(p)), n)
}
unsafe fn output<'a>(anchor: &'a mut (), j: &Job, n: usize) -> &'a mut [u8] {
  return unsafe Pointer.borrowManyMut<(), u8>(move anchor, unsafe Pointer.assumeManyMut<u8>(unsafe nonnull<u8>(j.output)), n)
