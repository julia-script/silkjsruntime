    if nid != 0 {
      if j.numbers[1] == 0 { name = unsafe xssl.OBJ_nid2sn(nid) }
      else { name = unsafe xssl.EC_curve_nid2nist(nid) }
    }
    if Pointer.isNull<u8>(name) { j.resultKind = 4 }
    else { j.resultKind = 3 ok = unsafe certificateCopy(&mut j, name, unsafe textLength(name)) }
  }
  unsafe ssl.EC_KEY_free(ec) return ok
}

