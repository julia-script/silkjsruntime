    ok = ok && unsafe pssl.EVP_PKEY_decapsulate(ctx, nil(), Pointer.fromMutRef<usize>(&mut shared), j.data[1], j.lengths[1]) > 0
    ok = ok && unsafe reserve(&mut j, shared) && unsafe pssl.EVP_PKEY_decapsulate(ctx, j.output, Pointer.fromMutRef<usize>(&mut j.length), j.data[1], j.lengths[1]) > 0
