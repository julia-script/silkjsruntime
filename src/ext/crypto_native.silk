}
/// Whether silk.crypto implements the cipher named by data[1]. Legacy and des3-wrap names are
/// known to the table but have no implementation.
unsafe fn cipherAvailable(j: &Job) -> bool {
  let a = ()
  let found = cipher.lookup(unsafe view(&a, j.data[1], j.lengths[1]))
  return match found {
    Option<u32>.Some { value } => match cipher.spec(value).mode { Mode.Legacy => false Mode.Des3Wrap => false _ => true }
    Option<u32>.None => false
  }
}
