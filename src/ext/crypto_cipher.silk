//! Node's cipher table and the cipher states behind `crypto.createCipheriv`, on silk.crypto.
//!
//! The names, NIDs and lengths are what Node 22 with OpenSSL's default provider accepts and
//! reports. Each update and finish writes the bytes OpenSSL would write for the same calls, so the
//! split of the output across `update` and `final` matches Node.
import silk.core.option { Option }
import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.num.u8
import silk.num.u32
import silk.num.i32
import silk.num.i64
import silk.num.usize
import silk.crypto.aes { AesEcb, AesCbc, AesCtr, AesCfb, AesCfb8, AesCfb1, AesOfb, AesError }
import silk.crypto.aes_gcm { AesGcmEncryptor, AesGcmDecryptor, AesGcmError }
import silk.crypto.aes_ccm { AesCcm, AesCcmError }
import silk.crypto.aes_ocb { AesOcbEncryptor, AesOcbDecryptor, AesOcbError }
import silk.crypto.aes_xts { AesXts, AesXtsError }
import silk.crypto.aes_wrap { AesKeyWrap, AesKeyWrapError }
import silk.crypto.des_wrap { TripleDesKeyWrap }
import silk.core.effect { Effect }
import silk.system.random { Random }
import silk.system.random_native { OsRandom }
import silk.crypto.aria { Aria }
import silk.crypto.camellia { Camellia }
import silk.crypto.sm4 { Sm4 }
import silk.crypto.des { TripleDes }
import silk.crypto.block_cipher { BlockCipherError, Ecb, Cbc, Ctr, Cfb, Cfb8, Cfb1, Ofb }
import silk.crypto.chacha20_poly1305 { ChaCha20, ChaCha20Error, ChaCha20Poly1305Encryptor, ChaCha20Poly1305Decryptor, AeadError }

/// The block cipher or stream cipher under a Node cipher name.
pub enum Family { Aes, Aria, Camellia, Sm4, TripleDes, ChaCha20, Legacy }

/// How the cipher is used. `CbcHmac` is OpenSSL's stitched cipher, which without a MAC key is CBC
/// without padding on whole blocks. `Legacy` names are known but live in OpenSSL's legacy provider.
pub enum Mode { Ecb, Cbc, CbcHmac, Cfb, Cfb1, Cfb8, Ofb, Ctr, Gcm, Ccm, Ocb, Xts, Wrap, WrapPad, Des3Wrap, Stream, Poly1305, Legacy }

/// What `crypto.getCipherInfo` reports for a cipher, and how to run it.
pub struct Spec {
  pub name: &'static [u8], pub nid: i32, pub family: Family, pub mode: Mode,
  pub opensslMode: i32, pub blockSize: i32, pub keyLength: i32, pub ivLength: i32,
}

struct Name { text: &'static [u8], spec: u32 }

const SPECS: [Spec; 140] = [
