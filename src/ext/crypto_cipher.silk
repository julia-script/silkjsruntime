/// The newline-separated names `crypto.getCiphers()` lists, as Node lists them.
pub const CIPHER_NAMES: &'static [u8] = b"aes-128-cbc\naes-128-cbc-hmac-sha1\naes-128-cbc-hmac-sha256\naes-128-ccm\naes-128-cfb\naes-128-cfb1\naes-128-cfb8\naes-128-ctr\naes-128-ecb\naes-128-gcm\naes-128-ocb\naes-128-ofb\naes-128-xts\naes-192-cbc\naes-192-ccm\naes-192-cfb\naes-192-cfb1\naes-192-cfb8\naes-192-ctr\naes-192-ecb\naes-192-gcm\naes-192-ocb\naes-192-ofb\naes-256-cbc\naes-256-cbc-hmac-sha1\naes-256-cbc-hmac-sha256\naes-256-ccm\naes-256-cfb\naes-256-cfb1\naes-256-cfb8\naes-256-ctr\naes-256-ecb\naes-256-gcm\naes-256-ocb\naes-256-ofb\naes-256-xts\naes128\naes128-wrap\naes128-wrap-pad\naes192\naes192-wrap\naes192-wrap-pad\naes256\naes256-wrap\naes256-wrap-pad\naria-128-cbc\naria-128-ccm\naria-128-cfb\naria-128-cfb1\naria-128-cfb8\naria-128-ctr\naria-128-ecb\naria-128-gcm\naria-128-ofb\naria-192-cbc\naria-192-ccm\naria-192-cfb\naria-192-cfb1\naria-192-cfb8\naria-192-ctr\naria-192-ecb\naria-192-gcm\naria-192-ofb\naria-256-cbc\naria-256-ccm\naria-256-cfb\naria-256-cfb1\naria-256-cfb8\naria-256-ctr\naria-256-ecb\naria-256-gcm\naria-256-ofb\naria128\naria192\naria256\ncamellia-128-cbc\ncamellia-128-cfb\ncamellia-128-cfb1\ncamellia-128-cfb8\ncamellia-128-ctr\ncamellia-128-ecb\ncamellia-128-ofb\ncamellia-192-cbc\ncamellia-192-cfb\ncamellia-192-cfb1\ncamellia-192-cfb8\ncamellia-192-ctr\ncamellia-192-ecb\ncamellia-192-ofb\ncamellia-256-cbc\ncamellia-256-cfb\ncamellia-256-cfb1\ncamellia-256-cfb8\ncamellia-256-ctr\ncamellia-256-ecb\ncamellia-256-ofb\ncamellia128\ncamellia192\ncamellia256\nchacha20\nchacha20-poly1305\ndes-ede\ndes-ede-cbc\ndes-ede-cfb\ndes-ede-ecb\ndes-ede-ofb\ndes-ede3\ndes-ede3-cbc\ndes-ede3-cfb\ndes-ede3-cfb1\ndes-ede3-cfb8\ndes-ede3-ecb\ndes-ede3-ofb\ndes3\ndes3-wrap\nid-aes128-CCM\nid-aes128-GCM\nid-aes128-wrap\nid-aes128-wrap-pad\nid-aes192-CCM\nid-aes192-GCM\nid-aes192-wrap\nid-aes192-wrap-pad\nid-aes256-CCM\nid-aes256-GCM\nid-aes256-wrap\nid-aes256-wrap-pad\nid-smime-alg-CMS3DESwrap\nsm4\nsm4-cbc\nsm4-cfb\nsm4-ctr\nsm4-ecb\nsm4-ofb\n"

fn lower(byte: u8) -> u8 { if byte >= 65 && byte <= 90 { return byte + 32 } return byte }

fn sameName(text: &[u8], name: &[u8]) -> bool {
  if text.length != name.length { return false }
  let mut k: usize = 0
  while k < text.length { if lower(name[k]) != text[k] { return false } k = k + 1 }
  return true
}

/// Returns the table index of the cipher `name` names, ignoring the case of ASCII letters.
pub fn lookup(name: &[u8]) -> Option<u32> {
  let mut i: usize = 0
  while i < NAMES.length {
    if sameName(NAMES[i].text, name) { return Option<u32>.some(NAMES[i].spec) }
    i = i + 1
  }
  return Option<u32>.none()
}

/// Returns the table index of the cipher with OpenSSL NID `nid`.
pub fn byNid(nid: i32) -> Option<u32> {
  let mut i: usize = 0
  while i < SPECS.length { if SPECS[i].nid == nid { return Option<u32>.some(usize.toU32(i)) } i = i + 1 }
  return Option<u32>.none()
}

/// Returns the table entry at `index`, which [`lookup`] or [`byNid`] returned.
pub fn spec(index: u32) -> &'static Spec { return &SPECS[u32.toUsize(index)] }

/// Whether the cipher takes an IV of `length` bytes. GCM takes 1 to 128 bytes, CCM 7 to 13 and
/// OCB 1 to 15, as Node reports; every other cipher takes exactly its IV length.
pub fn ivAllowed(entry: &Spec, length: usize) -> bool {
  return match entry.mode {
    Mode.Gcm => length >= 1 && length <= 128
    Mode.Ccm => length >= 7 && length <= 13
    Mode.Ocb => length >= 1 && length <= 15
    _ => length == i32.toUsize(entry.ivLength)
  }
}

/// Why a cipher call failed. [`errorText`] gives the message Node reports.
pub enum CipherError {
  UnknownCipher, Unsupported, InvalidKeyLength, InvalidIv, DuplicateXtsKeys, UnsupportedState,
  WrongFinalBlockLength, BadDecrypt, AuthenticationFailed, Unavailable,
}

/// The error text in the "CODE: message" form that node:crypto turns into `e.code`. `ERR_NONE`
/// marks the errors that Node reports without a code.
pub fn errorText(error: CipherError) -> &'static [u8] {
  return match move error {
    CipherError.UnknownCipher => b"ERR_CRYPTO_UNKNOWN_CIPHER: Unknown cipher"
    CipherError.Unsupported => b"ERR_OSSL_EVP_UNSUPPORTED: error:0308010C:digital envelope routines::unsupported"
    CipherError.InvalidKeyLength => b"ERR_CRYPTO_INVALID_KEYLEN: Invalid key length"
    CipherError.InvalidIv => b"ERR_CRYPTO_INVALID_IV: Invalid initialization vector"
    CipherError.DuplicateXtsKeys => b"error:1C800095:Provider routines::xts duplicated keys"
    CipherError.UnsupportedState => b"ERR_NONE: Trying to add data in unsupported state"
    CipherError.WrongFinalBlockLength => b"error:1C80006B:Provider routines::wrong final block length"
    CipherError.BadDecrypt => b"error:1C800064:Provider routines::bad decrypt"
    CipherError.AuthenticationFailed => b"ERR_NONE: Unsupported state or unable to authenticate data"
    CipherError.Unavailable => b"ERR_CRYPTO_UNSUPPORTED_OPERATION: This cipher setting is not available in silk.crypto yet"
  }
}

/// The key, IV and direction of one cipher, checked as Node checks them at creation.
pub struct Setup {
  pub index: u32, pub encrypt: bool, pub tagLength: usize,
  keyBytes: [u8; 64], keyLength: usize, ivBytes: [u8; 128], ivLength: usize,
}

impl Setup {
  /// Checks `key` and `iv` for the cipher at `index` and keeps copies of them.
  pub fn make(index: u32, key: &[u8], iv: &[u8], encrypt: bool, tagLength: usize) -> Result<Setup, CipherError> {
    let entry = spec(index)
    let refuse = match entry.mode {
      Mode.Legacy => Option<CipherError>.some(CipherError.Unsupported)
      _ => Option<CipherError>.none()
    }
    if let Option.Some { value } = refuse { return Result<Setup, CipherError>.failResult(value) }
    if key.length != i32.toUsize(entry.keyLength) { return Result<Setup, CipherError>.failResult(CipherError.InvalidKeyLength) }
    if !ivAllowed(entry, iv.length) { return Result<Setup, CipherError>.failResult(CipherError.InvalidIv) }
    if isXts(entry.mode) && encrypt {
      let half = key.length / 2 let mut same = true let mut i: usize = 0
      while i < half { if key[i] != key[half + i] { same = false } i = i + 1 }
      if same { return Result<Setup, CipherError>.failResult(CipherError.DuplicateXtsKeys) }
    }
    if !available(entry, iv.length, tagLength) { return Result<Setup, CipherError>.failResult(CipherError.Unavailable) }
    let mut setup = Setup { index: index, encrypt: encrypt, tagLength: tagLength, keyBytes: [0; 64], keyLength: key.length, ivBytes: [0; 128], ivLength: iv.length }
    Slice.copyInto<u8>(&mut setup.keyBytes, 0, key)
    Slice.copyInto<u8>(&mut setup.ivBytes, 0, iv)
    return Result<Setup, CipherError>.succeed(move setup)
  }

  /// The key bytes.
  pub fn key(self: &Self) -> &[u8] { return Slice.view<u8>(&self.keyBytes, 0, self.keyLength) }

  /// The IV bytes.
  pub fn iv(self: &Self) -> &[u8] { return Slice.view<u8>(&self.ivBytes, 0, self.ivLength) }
}

fn isXts(mode: Mode) -> bool { return match mode { Mode.Xts => true _ => false } }

// Settings that Node accepts and silk.crypto does not run yet: GCM nonces other than 12 bytes,
// GCM and ChaCha20-Poly1305 tags shorter than 16 bytes when decrypting, and ARIA GCM and CCM.
fn available(entry: &Spec, ivLength: usize, tagLength: usize) -> bool {
  return match entry.family {
    Family.Aria => match entry.mode { Mode.Gcm => false Mode.Ccm => false _ => true }
    _ => true
  }
}

fn started(state: CipherState) -> Result<CipherState, CipherError> { return Result<CipherState, CipherError>.succeed(move state) }
fn done(count: usize) -> Result<usize, CipherError> { return Result<usize, CipherError>.succeed(count) }
fn unsupported() -> Result<usize, CipherError> { return Result<usize, CipherError>.failResult(CipherError.UnsupportedState) }

fn aesError(error: AesError) -> CipherError {
  return match move error {
    AesError.InvalidInputLength => CipherError.WrongFinalBlockLength
    AesError.InvalidPadding => CipherError.BadDecrypt
    AesError.InvalidKeyLength => CipherError.InvalidKeyLength
    AesError.InvalidIvLength => CipherError.InvalidIv
    AesError.OutputTooSmall => CipherError.UnsupportedState
  }
}

fn chainError(error: BlockCipherError) -> CipherError {
  return match move error {
    BlockCipherError.InvalidInputLength => CipherError.WrongFinalBlockLength
    BlockCipherError.InvalidPadding => CipherError.BadDecrypt
    BlockCipherError.InvalidKeyLength => CipherError.InvalidKeyLength
    BlockCipherError.InvalidIvLength => CipherError.InvalidIv
    BlockCipherError.OutputTooSmall => CipherError.UnsupportedState
  }
}

fn blockResult(result: Result<usize, AesError>) -> Result<usize, CipherError> {
  return match move result {
    Result.Success { value } => done(value)
    Result.Failure { error } => Result<usize, CipherError>.failResult(aesError(move error))
  }
}

fn chainResult(result: Result<usize, BlockCipherError>) -> Result<usize, CipherError> {
  return match move result {
    Result.Success { value } => done(value)
    Result.Failure { error } => Result<usize, CipherError>.failResult(chainError(move error))
  }
}

fn streamResult(count: usize, result: Result<(), AesError>) -> Result<usize, CipherError> {
  return match move result {
    Result.Success { .. } => done(count)
    Result.Failure { error } => Result<usize, CipherError>.failResult(aesError(move error))
  }
}

fn chainStream(count: usize, result: Result<(), BlockCipherError>) -> Result<usize, CipherError> {
  return match move result {
    Result.Success { .. } => done(count)
    Result.Failure { error } => Result<usize, CipherError>.failResult(chainError(move error))
  }
}

/// A cipher in progress. `Pending` until the first update, so that padding and associated data
/// set after creation still apply; `Finished` once `finish` ran.
pub union CipherState {
  Pending,
  AesCbc { state: AesCbc },
  AesCfb { state: AesCfb },
  AesCfb1 { state: AesCfb1 },
  AesCfb8 { state: AesCfb8 },
  AesCtr { state: AesCtr },
  AesEcb { state: AesEcb },
  AesOfb { state: AesOfb },
  AriaCbc { state: Cbc<Aria> },
  AriaCfb { state: Cfb<Aria> },
  AriaCfb1 { state: Cfb1<Aria> },
  AriaCfb8 { state: Cfb8<Aria> },
  AriaCtr { state: Ctr<Aria> },
  AriaEcb { state: Ecb<Aria> },
  AriaOfb { state: Ofb<Aria> },
  CamelliaCbc { state: Cbc<Camellia> },
  CamelliaCfb { state: Cfb<Camellia> },
  CamelliaCfb1 { state: Cfb1<Camellia> },
  CamelliaCfb8 { state: Cfb8<Camellia> },
  CamelliaCtr { state: Ctr<Camellia> },
  CamelliaEcb { state: Ecb<Camellia> },
  CamelliaOfb { state: Ofb<Camellia> },
  Sm4Cbc { state: Cbc<Sm4> },
  Sm4Cfb { state: Cfb<Sm4> },
  Sm4Ctr { state: Ctr<Sm4> },
  Sm4Ecb { state: Ecb<Sm4> },
  Sm4Ofb { state: Ofb<Sm4> },
  TripleDesCbc { state: Cbc<TripleDes> },
  TripleDesCfb { state: Cfb<TripleDes> },
  TripleDesCfb1 { state: Cfb1<TripleDes> },
  TripleDesCfb8 { state: Cfb8<TripleDes> },
  TripleDesEcb { state: Ecb<TripleDes> },
  TripleDesOfb { state: Ofb<TripleDes> },
  AesCbcHmac { state: AesCbc },
  AesGcmEncrypt { state: AesGcmEncryptor },
  AesGcmDecrypt { state: AesGcmDecryptor },
  AesOcbEncrypt { state: AesOcbEncryptor },
  AesOcbDecrypt { state: AesOcbDecryptor },
  PolyEncrypt { state: ChaCha20Poly1305Encryptor },
  PolyDecrypt { state: ChaCha20Poly1305Decryptor },
  ChaCha { state: ChaCha20 },
  /// XTS and key wrap take each update as one whole message.
  PerUpdate,
  /// CCM takes one update; `failed` records a tag that did not verify.
  Ccm { used: bool, failed: bool, tag: [u8; 16] },
  Finished,
}

impl CipherState {
  /// Builds the state for `setup` once padding and associated data are known.
  pub fn start(setup: &Setup, padding: bool, aad: &[u8]) -> Result<CipherState, CipherError> {
    let entry = spec(setup.index)
    let family = entry.family let mode = entry.mode
    let key = setup.key() let iv = setup.iv()
    if family == Family.Aes && mode == Mode.Cbc {
      if let Result.Success { value } = if setup.encrypt { AesCbc.encryptor(key, iv, padding) } else { AesCbc.decryptor(key, iv, padding) } { return started(CipherState.AesCbc { state: move value }) }
      return Result<CipherState, CipherError>.failResult(CipherError.InvalidIv)
    }
    if family == Family.Aes && mode == Mode.Cfb {
      if let Result.Success { value } = if setup.encrypt { AesCfb.encryptor(key, iv) } else { AesCfb.decryptor(key, iv) } { return started(CipherState.AesCfb { state: move value }) }
      return Result<CipherState, CipherError>.failResult(CipherError.InvalidIv)
    }
    if family == Family.Aes && mode == Mode.Cfb1 {
      if let Result.Success { value } = if setup.encrypt { AesCfb1.encryptor(key, iv) } else { AesCfb1.decryptor(key, iv) } { return started(CipherState.AesCfb1 { state: move value }) }
      return Result<CipherState, CipherError>.failResult(CipherError.InvalidIv)
    }
    if family == Family.Aes && mode == Mode.Cfb8 {
      if let Result.Success { value } = if setup.encrypt { AesCfb8.encryptor(key, iv) } else { AesCfb8.decryptor(key, iv) } { return started(CipherState.AesCfb8 { state: move value }) }
      return Result<CipherState, CipherError>.failResult(CipherError.InvalidIv)
    }
    if family == Family.Aes && mode == Mode.Ctr {
      if let Result.Success { value } = AesCtr.make(key, iv) { return started(CipherState.AesCtr { state: move value }) }
      return Result<CipherState, CipherError>.failResult(CipherError.InvalidIv)
    }
    if family == Family.Aes && mode == Mode.Ecb {
      if let Result.Success { value } = if setup.encrypt { AesEcb.encryptor(key, padding) } else { AesEcb.decryptor(key, padding) } { return started(CipherState.AesEcb { state: move value }) }
      return Result<CipherState, CipherError>.failResult(CipherError.InvalidIv)
    }
    if family == Family.Aes && mode == Mode.Ofb {
      if let Result.Success { value } = AesOfb.make(key, iv) { return started(CipherState.AesOfb { state: move value }) }
      return Result<CipherState, CipherError>.failResult(CipherError.InvalidIv)
    }
    if family == Family.Aria && mode == Mode.Cbc {
      if let Result.Success { value: cipher } = Aria.make(key) { let made = if setup.encrypt { Cbc<Aria>.encryptor(move cipher, iv, padding) } else { Cbc<Aria>.decryptor(move cipher, iv, padding) } if let Result.Success { value } = move made { return started(CipherState.AriaCbc { state: move value }) } }
      return Result<CipherState, CipherError>.failResult(CipherError.InvalidKeyLength)
    }
    if family == Family.Aria && mode == Mode.Cfb {
      if let Result.Success { value: cipher } = Aria.make(key) { let made = if setup.encrypt { Cfb<Aria>.encryptor(move cipher, iv) } else { Cfb<Aria>.decryptor(move cipher, iv) } if let Result.Success { value } = move made { return started(CipherState.AriaCfb { state: move value }) } }
      return Result<CipherState, CipherError>.failResult(CipherError.InvalidKeyLength)
    }
    if family == Family.Aria && mode == Mode.Cfb1 {
      if let Result.Success { value: cipher } = Aria.make(key) { let made = if setup.encrypt { Cfb1<Aria>.encryptor(move cipher, iv) } else { Cfb1<Aria>.decryptor(move cipher, iv) } if let Result.Success { value } = move made { return started(CipherState.AriaCfb1 { state: move value }) } }
      return Result<CipherState, CipherError>.failResult(CipherError.InvalidKeyLength)
    }
    if family == Family.Aria && mode == Mode.Cfb8 {
      if let Result.Success { value: cipher } = Aria.make(key) { let made = if setup.encrypt { Cfb8<Aria>.encryptor(move cipher, iv) } else { Cfb8<Aria>.decryptor(move cipher, iv) } if let Result.Success { value } = move made { return started(CipherState.AriaCfb8 { state: move value }) } }
      return Result<CipherState, CipherError>.failResult(CipherError.InvalidKeyLength)
    }
    if family == Family.Aria && mode == Mode.Ctr {
      if let Result.Success { value: cipher } = Aria.make(key) { if let Result.Success { value } = Ctr<Aria>.make(move cipher, iv) { return started(CipherState.AriaCtr { state: move value }) } }
      return Result<CipherState, CipherError>.failResult(CipherError.InvalidKeyLength)
    }
    if family == Family.Aria && mode == Mode.Ecb {
      if let Result.Success { value: cipher } = Aria.make(key) { let made = if setup.encrypt { Ecb<Aria>.encryptor(move cipher, padding) } else { Ecb<Aria>.decryptor(move cipher, padding) } return started(CipherState.AriaEcb { state: move made }) }
      return Result<CipherState, CipherError>.failResult(CipherError.InvalidKeyLength)
    }
    if family == Family.Aria && mode == Mode.Ofb {
      if let Result.Success { value: cipher } = Aria.make(key) { if let Result.Success { value } = Ofb<Aria>.make(move cipher, iv) { return started(CipherState.AriaOfb { state: move value }) } }
      return Result<CipherState, CipherError>.failResult(CipherError.InvalidKeyLength)
    }
    if family == Family.Camellia && mode == Mode.Cbc {
      if let Result.Success { value: cipher } = Camellia.make(key) { let made = if setup.encrypt { Cbc<Camellia>.encryptor(move cipher, iv, padding) } else { Cbc<Camellia>.decryptor(move cipher, iv, padding) } if let Result.Success { value } = move made { return started(CipherState.CamelliaCbc { state: move value }) } }
      return Result<CipherState, CipherError>.failResult(CipherError.InvalidKeyLength)
    }
    if family == Family.Camellia && mode == Mode.Cfb {
      if let Result.Success { value: cipher } = Camellia.make(key) { let made = if setup.encrypt { Cfb<Camellia>.encryptor(move cipher, iv) } else { Cfb<Camellia>.decryptor(move cipher, iv) } if let Result.Success { value } = move made { return started(CipherState.CamelliaCfb { state: move value }) } }
      return Result<CipherState, CipherError>.failResult(CipherError.InvalidKeyLength)
    }
    if family == Family.Camellia && mode == Mode.Cfb1 {
      if let Result.Success { value: cipher } = Camellia.make(key) { let made = if setup.encrypt { Cfb1<Camellia>.encryptor(move cipher, iv) } else { Cfb1<Camellia>.decryptor(move cipher, iv) } if let Result.Success { value } = move made { return started(CipherState.CamelliaCfb1 { state: move value }) } }
      return Result<CipherState, CipherError>.failResult(CipherError.InvalidKeyLength)
    }
    if family == Family.Camellia && mode == Mode.Cfb8 {
      if let Result.Success { value: cipher } = Camellia.make(key) { let made = if setup.encrypt { Cfb8<Camellia>.encryptor(move cipher, iv) } else { Cfb8<Camellia>.decryptor(move cipher, iv) } if let Result.Success { value } = move made { return started(CipherState.CamelliaCfb8 { state: move value }) } }
      return Result<CipherState, CipherError>.failResult(CipherError.InvalidKeyLength)
    }
    if family == Family.Camellia && mode == Mode.Ctr {
      if let Result.Success { value: cipher } = Camellia.make(key) { if let Result.Success { value } = Ctr<Camellia>.make(move cipher, iv) { return started(CipherState.CamelliaCtr { state: move value }) } }
      return Result<CipherState, CipherError>.failResult(CipherError.InvalidKeyLength)
    }
    if family == Family.Camellia && mode == Mode.Ecb {
      if let Result.Success { value: cipher } = Camellia.make(key) { let made = if setup.encrypt { Ecb<Camellia>.encryptor(move cipher, padding) } else { Ecb<Camellia>.decryptor(move cipher, padding) } return started(CipherState.CamelliaEcb { state: move made }) }
      return Result<CipherState, CipherError>.failResult(CipherError.InvalidKeyLength)
    }
    if family == Family.Camellia && mode == Mode.Ofb {
      if let Result.Success { value: cipher } = Camellia.make(key) { if let Result.Success { value } = Ofb<Camellia>.make(move cipher, iv) { return started(CipherState.CamelliaOfb { state: move value }) } }
      return Result<CipherState, CipherError>.failResult(CipherError.InvalidKeyLength)
    }
    if family == Family.Sm4 && mode == Mode.Cbc {
      if let Result.Success { value: cipher } = Sm4.make(key) { let made = if setup.encrypt { Cbc<Sm4>.encryptor(move cipher, iv, padding) } else { Cbc<Sm4>.decryptor(move cipher, iv, padding) } if let Result.Success { value } = move made { return started(CipherState.Sm4Cbc { state: move value }) } }
      return Result<CipherState, CipherError>.failResult(CipherError.InvalidKeyLength)
    }
    if family == Family.Sm4 && mode == Mode.Cfb {
      if let Result.Success { value: cipher } = Sm4.make(key) { let made = if setup.encrypt { Cfb<Sm4>.encryptor(move cipher, iv) } else { Cfb<Sm4>.decryptor(move cipher, iv) } if let Result.Success { value } = move made { return started(CipherState.Sm4Cfb { state: move value }) } }
      return Result<CipherState, CipherError>.failResult(CipherError.InvalidKeyLength)
    }
    if family == Family.Sm4 && mode == Mode.Ctr {
      if let Result.Success { value: cipher } = Sm4.make(key) { if let Result.Success { value } = Ctr<Sm4>.make(move cipher, iv) { return started(CipherState.Sm4Ctr { state: move value }) } }
      return Result<CipherState, CipherError>.failResult(CipherError.InvalidKeyLength)
    }
    if family == Family.Sm4 && mode == Mode.Ecb {
      if let Result.Success { value: cipher } = Sm4.make(key) { let made = if setup.encrypt { Ecb<Sm4>.encryptor(move cipher, padding) } else { Ecb<Sm4>.decryptor(move cipher, padding) } return started(CipherState.Sm4Ecb { state: move made }) }
      return Result<CipherState, CipherError>.failResult(CipherError.InvalidKeyLength)
    }
    if family == Family.Sm4 && mode == Mode.Ofb {
      if let Result.Success { value: cipher } = Sm4.make(key) { if let Result.Success { value } = Ofb<Sm4>.make(move cipher, iv) { return started(CipherState.Sm4Ofb { state: move value }) } }
      return Result<CipherState, CipherError>.failResult(CipherError.InvalidKeyLength)
    }
    if family == Family.TripleDes && mode == Mode.Cbc {
      if let Result.Success { value: cipher } = TripleDes.make(key) { let made = if setup.encrypt { Cbc<TripleDes>.encryptor(move cipher, iv, padding) } else { Cbc<TripleDes>.decryptor(move cipher, iv, padding) } if let Result.Success { value } = move made { return started(CipherState.TripleDesCbc { state: move value }) } }
      return Result<CipherState, CipherError>.failResult(CipherError.InvalidKeyLength)
    }
    if family == Family.TripleDes && mode == Mode.Cfb {
      if let Result.Success { value: cipher } = TripleDes.make(key) { let made = if setup.encrypt { Cfb<TripleDes>.encryptor(move cipher, iv) } else { Cfb<TripleDes>.decryptor(move cipher, iv) } if let Result.Success { value } = move made { return started(CipherState.TripleDesCfb { state: move value }) } }
      return Result<CipherState, CipherError>.failResult(CipherError.InvalidKeyLength)
    }
    if family == Family.TripleDes && mode == Mode.Cfb1 {
      if let Result.Success { value: cipher } = TripleDes.make(key) { let made = if setup.encrypt { Cfb1<TripleDes>.encryptor(move cipher, iv) } else { Cfb1<TripleDes>.decryptor(move cipher, iv) } if let Result.Success { value } = move made { return started(CipherState.TripleDesCfb1 { state: move value }) } }
      return Result<CipherState, CipherError>.failResult(CipherError.InvalidKeyLength)
    }
    if family == Family.TripleDes && mode == Mode.Cfb8 {
      if let Result.Success { value: cipher } = TripleDes.make(key) { let made = if setup.encrypt { Cfb8<TripleDes>.encryptor(move cipher, iv) } else { Cfb8<TripleDes>.decryptor(move cipher, iv) } if let Result.Success { value } = move made { return started(CipherState.TripleDesCfb8 { state: move value }) } }
      return Result<CipherState, CipherError>.failResult(CipherError.InvalidKeyLength)
    }
    if family == Family.TripleDes && mode == Mode.Ecb {
      if let Result.Success { value: cipher } = TripleDes.make(key) { let made = if setup.encrypt { Ecb<TripleDes>.encryptor(move cipher, padding) } else { Ecb<TripleDes>.decryptor(move cipher, padding) } return started(CipherState.TripleDesEcb { state: move made }) }
      return Result<CipherState, CipherError>.failResult(CipherError.InvalidKeyLength)
    }
    if family == Family.TripleDes && mode == Mode.Ofb {
      if let Result.Success { value: cipher } = TripleDes.make(key) { if let Result.Success { value } = Ofb<TripleDes>.make(move cipher, iv) { return started(CipherState.TripleDesOfb { state: move value }) } }
      return Result<CipherState, CipherError>.failResult(CipherError.InvalidKeyLength)
    }
    if family == Family.Aes && mode == Mode.CbcHmac {
      if let Result.Success { value } = if setup.encrypt { AesCbc.encryptor(key, iv, false) } else { AesCbc.decryptor(key, iv, false) } { return started(CipherState.AesCbcHmac { state: move value }) }
      return Result<CipherState, CipherError>.failResult(CipherError.InvalidIv)
    }
    return match mode {
      Mode.Gcm => {
        if setup.encrypt {
          if let Result.Success { value } = AesGcmEncryptor.make(key, iv, aad) { return started(CipherState.AesGcmEncrypt { state: move value }) }
        } else if let Result.Success { value } = AesGcmDecryptor.make(key, iv, aad) { return started(CipherState.AesGcmDecrypt { state: move value }) }
        Result<CipherState, CipherError>.failResult(CipherError.InvalidIv)
      }
      Mode.Ocb => {
        if setup.encrypt {
          if let Result.Success { value } = AesOcbEncryptor.make(key, iv, aad, setup.tagLength) { return started(CipherState.AesOcbEncrypt { state: move value }) }
        } else if let Result.Success { value } = AesOcbDecryptor.make(key, iv, aad, setup.tagLength) { return started(CipherState.AesOcbDecrypt { state: move value }) }
        Result<CipherState, CipherError>.failResult(CipherError.InvalidIv)
      }
      Mode.Poly1305 => {
        if setup.encrypt {
          if let Result.Success { value } = ChaCha20Poly1305Encryptor.make(key, iv, aad) { return started(CipherState.PolyEncrypt { state: move value }) }
        } else if let Result.Success { value } = ChaCha20Poly1305Decryptor.make(key, iv, aad) { return started(CipherState.PolyDecrypt { state: move value }) }
        Result<CipherState, CipherError>.failResult(CipherError.InvalidIv)
      }
      Mode.Stream => {
        // OpenSSL's chacha20 IV is the 32-bit little-endian block counter, then the 96-bit nonce.
        let counter = u8.toU32(iv[0]) | u32.shiftLeft(u8.toU32(iv[1]), 8) | u32.shiftLeft(u8.toU32(iv[2]), 16) | u32.shiftLeft(u8.toU32(iv[3]), 24)
        if let Result.Success { value } = ChaCha20.make(key, Slice.view<u8>(iv, 4, 12), counter) { return started(CipherState.ChaCha { state: move value }) }
        Result<CipherState, CipherError>.failResult(CipherError.InvalidIv)
      }
      Mode.Ccm => started(CipherState.Ccm { used: false, failed: false, tag: [0; 16] })
      _ => started(CipherState.PerUpdate)
    }
  }

  /// Runs `input` through the cipher into `output` and returns the bytes written. `output` holds
  /// at least `input.length` + 48 bytes. `aad`, `plaintextLength` and `tag` are what CCM needs in
  /// its single update.
  pub fn update(self: &mut Self, setup: &Setup, aad: &[u8], plaintextLength: i64, tag: &[u8], input: &[u8], output: &mut [u8]) -> Result<usize, CipherError> {
    let mode = spec(setup.index).mode
    return match &mut self.* {
      CipherState.AesCbc { state } => blockResult(state.update(input, move output))
      CipherState.AesCfb { state } => streamResult(input.length, state.apply(input, move output))
      CipherState.AesCfb1 { state } => streamResult(input.length, state.apply(input, move output))
      CipherState.AesCfb8 { state } => streamResult(input.length, state.apply(input, move output))
      CipherState.AesCtr { state } => streamResult(input.length, state.apply(input, move output))
      CipherState.AesEcb { state } => blockResult(state.update(input, move output))
      CipherState.AesOfb { state } => streamResult(input.length, state.apply(input, move output))
      CipherState.AriaCbc { state } => chainResult(state.update(input, move output))
      CipherState.AriaCfb { state } => chainStream(input.length, state.apply(input, move output))
      CipherState.AriaCfb1 { state } => chainStream(input.length, state.apply(input, move output))
      CipherState.AriaCfb8 { state } => chainStream(input.length, state.apply(input, move output))
      CipherState.AriaCtr { state } => chainStream(input.length, state.apply(input, move output))
      CipherState.AriaEcb { state } => chainResult(state.update(input, move output))
      CipherState.AriaOfb { state } => chainStream(input.length, state.apply(input, move output))
      CipherState.CamelliaCbc { state } => chainResult(state.update(input, move output))
      CipherState.CamelliaCfb { state } => chainStream(input.length, state.apply(input, move output))
      CipherState.CamelliaCfb1 { state } => chainStream(input.length, state.apply(input, move output))
      CipherState.CamelliaCfb8 { state } => chainStream(input.length, state.apply(input, move output))
      CipherState.CamelliaCtr { state } => chainStream(input.length, state.apply(input, move output))
      CipherState.CamelliaEcb { state } => chainResult(state.update(input, move output))
      CipherState.CamelliaOfb { state } => chainStream(input.length, state.apply(input, move output))
      CipherState.Sm4Cbc { state } => chainResult(state.update(input, move output))
      CipherState.Sm4Cfb { state } => chainStream(input.length, state.apply(input, move output))
      CipherState.Sm4Ctr { state } => chainStream(input.length, state.apply(input, move output))
      CipherState.Sm4Ecb { state } => chainResult(state.update(input, move output))
      CipherState.Sm4Ofb { state } => chainStream(input.length, state.apply(input, move output))
      CipherState.TripleDesCbc { state } => chainResult(state.update(input, move output))
      CipherState.TripleDesCfb { state } => chainStream(input.length, state.apply(input, move output))
      CipherState.TripleDesCfb1 { state } => chainStream(input.length, state.apply(input, move output))
      CipherState.TripleDesCfb8 { state } => chainStream(input.length, state.apply(input, move output))
      CipherState.TripleDesEcb { state } => chainResult(state.update(input, move output))
      CipherState.TripleDesOfb { state } => chainStream(input.length, state.apply(input, move output))
      CipherState.AesCbcHmac { state } => { if input.length % 16 != 0 { return unsupported() } blockResult(state.update(input, move output)) }
      CipherState.AesGcmEncrypt { state } => match state.update(input, move output) { Result.Success { .. } => done(input.length) Result.Failure { .. } => unsupported() }
      CipherState.AesGcmDecrypt { state } => match state.update(input, move output) { Result.Success { .. } => done(input.length) Result.Failure { .. } => unsupported() }
      CipherState.AesOcbEncrypt { state } => match state.update(input, move output) { Result.Success { value } => done(value) Result.Failure { .. } => unsupported() }
      CipherState.AesOcbDecrypt { state } => match state.update(input, move output) { Result.Success { value } => done(value) Result.Failure { .. } => unsupported() }
      CipherState.PolyEncrypt { state } => match state.update(input, move output) { Result.Success { .. } => done(input.length) Result.Failure { .. } => unsupported() }
      CipherState.PolyDecrypt { state } => match state.update(input, move output) { Result.Success { .. } => done(input.length) Result.Failure { .. } => unsupported() }
      CipherState.ChaCha { state } => match state.apply(input, move output) { Result.Success { .. } => done(input.length) Result.Failure { .. } => unsupported() }
      CipherState.Ccm { used, failed, tag: sealed } => {
        if used || plaintextLength >= 0 && usize.toI64(input.length) != plaintextLength { return unsupported() }
        used = true
        if setup.encrypt {
          return match AesCcm.seal(setup.key(), setup.iv(), aad, input, move output, Slice.viewMut<u8>(&mut sealed, 0, setup.tagLength)) { Result.Success { .. } => done(input.length) Result.Failure { .. } => unsupported() }
        }
        if tag.length == 0 { failed = true return done(0) }
        match AesCcm.open(setup.key(), setup.iv(), aad, input, tag, move output) {
          Result.Success { .. } => done(input.length)
          Result.Failure { .. } => { failed = true done(0) }
        }
      }
      CipherState.PerUpdate => perUpdate(mode, setup, input, move output)
      _ => unsupported()
    }
  }

  /// Ends the message: writes the last bytes into `output`, which holds at least 48 bytes, and
  /// returns their number. An AEAD encryptor writes its 16-byte tag into `tagOutput`; a decryptor
  /// checks `tag`.
  pub fn finish(self: Self, setup: &Setup, aad: &[u8], tag: &[u8], output: &mut [u8], tagOutput: &mut [u8; 16]) -> Result<usize, CipherError> {
    return match move self {
      CipherState.AesCbc { state } => blockResult(state.finish(move output))
      CipherState.AesCfb { state } => done(0)
      CipherState.AesCfb1 { state } => done(0)
      CipherState.AesCfb8 { state } => done(0)
      CipherState.AesCtr { state } => done(0)
      CipherState.AesEcb { state } => blockResult(state.finish(move output))
      CipherState.AesOfb { state } => done(0)
      CipherState.AriaCbc { state } => chainResult(state.finish(move output))
      CipherState.AriaCfb { state } => done(0)
      CipherState.AriaCfb1 { state } => done(0)
      CipherState.AriaCfb8 { state } => done(0)
      CipherState.AriaCtr { state } => done(0)
      CipherState.AriaEcb { state } => chainResult(state.finish(move output))
      CipherState.AriaOfb { state } => done(0)
      CipherState.CamelliaCbc { state } => chainResult(state.finish(move output))
      CipherState.CamelliaCfb { state } => done(0)
      CipherState.CamelliaCfb1 { state } => done(0)
      CipherState.CamelliaCfb8 { state } => done(0)
      CipherState.CamelliaCtr { state } => done(0)
      CipherState.CamelliaEcb { state } => chainResult(state.finish(move output))
      CipherState.CamelliaOfb { state } => done(0)
      CipherState.Sm4Cbc { state } => chainResult(state.finish(move output))
      CipherState.Sm4Cfb { state } => done(0)
      CipherState.Sm4Ctr { state } => done(0)
      CipherState.Sm4Ecb { state } => chainResult(state.finish(move output))
      CipherState.Sm4Ofb { state } => done(0)
      CipherState.TripleDesCbc { state } => chainResult(state.finish(move output))
      CipherState.TripleDesCfb { state } => done(0)
      CipherState.TripleDesCfb1 { state } => done(0)
      CipherState.TripleDesCfb8 { state } => done(0)
      CipherState.TripleDesEcb { state } => chainResult(state.finish(move output))
      CipherState.TripleDesOfb { state } => done(0)
      CipherState.AesCbcHmac { state } => blockResult(state.finish(move output))
      CipherState.AesGcmEncrypt { state } => match state.finish(move tagOutput) { Result.Success { .. } => done(0) Result.Failure { .. } => unsupported() }
      CipherState.AesGcmDecrypt { state } => match state.finish(tag) { Result.Success { .. } => done(0) Result.Failure { .. } => authenticationFailed() }
      CipherState.AesOcbEncrypt { state } => match state.finish(move output, Slice.viewMut<u8>(move tagOutput, 0, setup.tagLength)) { Result.Success { value } => done(value) Result.Failure { .. } => unsupported() }
      CipherState.AesOcbDecrypt { state } => if tag.length != setup.tagLength { authenticationFailed() } else { match state.finish(move output, tag) { Result.Success { value } => done(value) Result.Failure { .. } => authenticationFailed() } }
      CipherState.PolyEncrypt { state } => match state.finish(move tagOutput) { Result.Success { .. } => done(0) Result.Failure { .. } => unsupported() }
      CipherState.PolyDecrypt { state } => if tag.length != 16 { authenticationFailed() } else { match state.finish(tag) { Result.Success { .. } => done(0) Result.Failure { .. } => authenticationFailed() } }
      CipherState.ChaCha { .. } => done(0)
      CipherState.Ccm { used, failed, tag: sealed } => {
        if failed { return authenticationFailed() }
        if used { Slice.copyInto<u8>(move tagOutput, 0, &sealed) return done(0) }
        // No update came: the message is empty, and the tag still covers the associated data.
        if setup.encrypt {
          return match AesCcm.seal(setup.key(), setup.iv(), aad, b"", Slice.viewMut<u8>(move output, 0, 0), Slice.viewMut<u8>(move tagOutput, 0, setup.tagLength)) { Result.Success { .. } => done(0) Result.Failure { .. } => unsupported() }
        }
        match AesCcm.open(setup.key(), setup.iv(), aad, b"", tag, Slice.viewMut<u8>(move output, 0, 0)) { Result.Success { .. } => done(0) Result.Failure { .. } => authenticationFailed() }
      }
      CipherState.PerUpdate => done(0)
      _ => unsupported()
    }
  }
}

fn authenticationFailed() -> Result<usize, CipherError> { return Result<usize, CipherError>.failResult(CipherError.AuthenticationFailed) }

// XTS and key wrap: OpenSSL treats each update as one whole message.
fn perUpdate(mode: Mode, setup: &Setup, input: &[u8], output: &mut [u8]) -> Result<usize, CipherError> {
  return match mode {
    Mode.Xts => {
      if input.length < 16 { return unsupported() }
      let result = if setup.encrypt { AesXts.encrypt(setup.key(), setup.iv(), input, move output) } else { AesXts.decrypt(setup.key(), setup.iv(), input, move output) }
      match move result { Result.Success { .. } => done(input.length) Result.Failure { .. } => unsupported() }
    }
    Mode.Wrap => {
      if input.length == 0 { return done(0) }
      let result = if setup.encrypt { AesKeyWrap.wrap(setup.key(), setup.iv(), input, move output) } else { AesKeyWrap.unwrap(setup.key(), setup.iv(), input, move output) }
      match move result { Result.Success { value } => done(value) Result.Failure { .. } => unsupported() }
    }
    Mode.Des3Wrap => {
      if input.length == 0 { return done(0) }
      let result = if setup.encrypt {
        // RFC 3217 draws a fresh IV for each wrap, as OpenSSL does.
        let mut iv: [u8; 8] = [0; 8]
        let mut random = OsRandom.make()
        run Random.fillBytes(&mut iv) |> Effect.provideMut<Random>(&mut random)
        TripleDesKeyWrap.wrap(setup.key(), &iv, input, move output)
      } else { TripleDesKeyWrap.unwrap(setup.key(), input, move output) }
      match move result { Result.Success { value } => done(value) Result.Failure { .. } => unsupported() }
    }
    Mode.WrapPad => {
      if input.length == 0 { return done(0) }
      let result = if setup.encrypt { AesKeyWrap.wrapPadded(setup.key(), setup.iv(), input, move output) } else { AesKeyWrap.unwrapPadded(setup.key(), setup.iv(), input, move output) }
      match move result { Result.Success { value } => done(value) Result.Failure { .. } => unsupported() }
    }
    _ => unsupported()
  }
}
