//! Hashes, HMAC, PBKDF2 and HKDF for node:crypto on `silk.crypto`, chosen by OpenSSL name at run
//! time.
//!
//! The names are the ones Node accepts with its default OpenSSL provider: the legacy names such as
//! `RSA-SHA256` and `sha256WithRSAEncryption`, the provider names such as `SHA2-256` and
//! `SHA-512/256`, and the dotted object identifiers, all without regard to ASCII case. MD4,
//! MDC-2 and Whirlpool are legacy-provider algorithms that Node refuses, so they are not here.
import silk.core.option { Option }
import silk.core.result { Result }
import silk.crypto.digest { Digest }
import silk.crypto.hmac { Hmac }
import silk.crypto.pbkdf2 { Pbkdf2, Pbkdf2Error }
import silk.crypto.hkdf { Hkdf, OutputTooLongError }
import silk.crypto.md5 { Md5 }
import silk.crypto.md5_sha1 { Md5Sha1 }
import silk.crypto.sha1 { Sha1 }
import silk.crypto.ripemd160 { Ripemd160 }
import silk.crypto.blake2b { Blake2b512 }
import silk.crypto.blake2s { Blake2s256 }
import silk.crypto.sha2 { Sha224, Sha256, Sha384, Sha512, Sha512_224, Sha512_256 }
import silk.crypto.sha3 { Sha3_224, Sha3_256, Sha3_384, Sha3_512, Shake128, Shake256 }
import silk.crypto.sm3 { Sm3 }

/// A hash that node:crypto can name.
pub enum Algorithm { Md5, Md5Sha1, Sha1, Ripemd160, Blake2b512, Blake2s256, Sha224, Sha256, Sha384, Sha512, Sha512_224, Sha512_256, Sha3_224, Sha3_256, Sha3_384, Sha3_512, Sm3, Shake128, Shake256 }

struct Name { text: &'static [u8], algorithm: Algorithm }
