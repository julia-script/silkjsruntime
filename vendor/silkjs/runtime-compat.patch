--- /dev/null
+++ b/native/kevent.c
@@ -0,0 +1,12 @@
+/* Keep the engine's kevent capture contract separate from the standard
+ * library declaration. The kernel retains each registration's udata, while
+ * the event output and timeout storage are only used during this call. */
+#include <sys/types.h>
+#include <sys/event.h>
+#include <time.h>
+
+int silkjs_kevent(int queue, const struct kevent *changes, int change_count,
+                  struct kevent *events, int event_count,
+                  const struct timespec *timeout) {
+    return kevent(queue, changes, change_count, events, event_count, timeout);
+}
